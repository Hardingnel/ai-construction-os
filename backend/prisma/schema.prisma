generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String
  role          String   @default("architect")
  avatar        String?
  phone         String?
  company       String?
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projects                  Project[]
  designs                   Design[]
  tasks                     Task[]
  teamMembers               TeamMember[]
  comments                  Comment[]
  aiGenerations             AIGeneration[]
  marketplacePlans          MarketplacePlan[]
  complianceChecks          ComplianceCheck[]
  sustainabilityAssessments SustainabilityAssessment[]
  tutorSessions             TutorSession[]
  importExportJobs          ImportExportJob[]
  conversionRecords         ConversionRecord[]
  bimFloorPlans             BIMFloorPlan[]
  orders                    Order[]
  Document                  Document[]
  notifications             Notification[]
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        String   @default("residential")
  status      String   @default("draft")
  location    String?
  budget      Float?
  area        Float?
  floors      Int?
  bedrooms    Int?
  style       String?
  progress    Int      @default(0)
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user                     User                       @relation(fields: [userId], references: [id])
  designs                  Design[]
  boqItems                 BOQItem[]
  tasks                    Task[]
  comments                 Comment[]
  documents                Document[]
  phases                   Phase[]
  projectPhases            ProjectPhase[]
  projectMilestones        ProjectMilestone[]
  expenses                 Expense[]
  gisData                  GISData[]
  complianceChecks         ComplianceCheck[]
  TeamMember               TeamMember[]
  SustainabilityAssessment SustainabilityAssessment[]
}

model Design {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("floor-plan")
  style       String?
  description String?
  prompt      String?
  data        String?
  projectId   String
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
}

model GISData {
  id        String   @id @default(cuid())
  latitude  Float
  longitude Float
  elevation Float?
  floodRisk String?
  soilType  String?
  projectId String?
  createdAt DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id])
}

model BOQItem {
  id          String   @id @default(cuid())
  code        String
  description String
  unit        String
  quantity    Float
  unitRate    Float
  total       Float
  category    String
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("pending")
  priority    String   @default("medium")
  dueDate     String?
  assigneeId  String?
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project  Project @relation(fields: [projectId], references: [id])
  assignee User?   @relation(fields: [assigneeId], references: [id])
}

model Phase {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("pending")
  progress    Int      @default(0)
  startDate   String?
  endDate     String?
  order       Int      @default(0)
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])
}

model Expense {
  id          String   @id @default(cuid())
  category    String
  description String?
  amount      Float
  date        String
  vendor      String?
  projectId   String
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
}

model Document {
  id           String   @id @default(cuid())
  name         String
  type         String
  data         String?
  url          String
  size         Int?
  projectId    String
  uploadedById String?
  createdAt    DateTime @default(now())

  project    Project @relation(fields: [projectId], references: [id])
  uploadedBy User?   @relation(fields: [uploadedById], references: [id])
}

model TeamMember {
  id         String   @id @default(cuid())
  role       String
  specialty  String?
  hourlyRate Float?
  status     String   @default("active")
  userId     String
  projectId  String?
  createdAt  DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  userId    String
  projectId String
  parentId  String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])
}

model AIGeneration {
  id        String   @id @default(cuid())
  prompt    String
  result    String
  type      String   @default("design")
  model     String?
  userId    String
  projectId String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model MarketplacePlan {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  type        String
  authorId    String
  rating      Float    @default(0)
  sales       Int      @default(0)
  fileUrl     String?
  thumbnail   String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author     User        @relation(fields: [authorId], references: [id])
  orderItems OrderItem[]
}

model Order {
  id        String   @id @default(cuid())
  userId    String
  total     Float
  status    String   @default("completed")
  createdAt DateTime @default(now())

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  planId  String
  price   Float

  order Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  plan  MarketplacePlan @relation(fields: [planId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  ip        String?
  metadata  String?
  createdAt DateTime @default(now())
}

model BuildingCode {
  id          String   @id @default(cuid())
  country     String
  region      String?
  code        String
  title       String
  description String?
  category    String
  requirement String
  parameters  String?
  severity    String   @default("mandatory")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  complianceResults ComplianceCheckResult[]
}

model ComplianceCheck {
  id           String    @id @default(cuid())
  status       String
  score        Float?
  summary      String?
  passedItems  Int       @default(0)
  failedItems  Int       @default(0)
  warningItems Int       @default(0)
  country      String
  buildingType String?
  projectId    String
  userId       String
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  project Project                 @relation(fields: [projectId], references: [id])
  user    User                    @relation(fields: [userId], references: [id])
  results ComplianceCheckResult[]
}

model ComplianceCheckResult {
  id             String   @id @default(cuid())
  ruleId         String?
  passed         Boolean  @default(true)
  status         String?
  title          String?
  description    String?
  requirement    String?
  finding        String?
  recommendation String?
  category       String?
  severity       String?
  checkId        String
  createdAt      DateTime @default(now())

  check ComplianceCheck @relation(fields: [checkId], references: [id])
  rule  BuildingCode?   @relation(fields: [ruleId], references: [id])
}

model SustainabilityAssessment {
  id                 String   @id @default(cuid())
  projectId          String?
  country            String   @default("SL")
  carbonFootprint    Float?
  carbonRating       String?
  energyEfficiency   Float?
  energyScore        Float?
  energyRating       String?
  solarPotential     String?
  solarKwhYear       Float?
  waterEfficiency    Float?
  waterRating        String?
  passiveCooling     String?
  floodResilience    String?
  greenMaterialScore Float?
  overallScore       Float?
  overallRating      String?
  recommendations    String?
  data               String?
  createdAt          DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id])
  User    User?    @relation(fields: [userId], references: [id])
  userId  String?
}

model TutorSession {
  id        String   @id @default(cuid())
  userId    String
  topic     String?
  context   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id])
  messages TutorMessage[]
}

model TutorMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String
  metadata  String?
  createdAt DateTime @default(now())

  session TutorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model GlossaryEntry {
  id           String   @id @default(cuid())
  term         String   @unique
  definition   String
  category     String?
  relatedTerms String?
  createdAt    DateTime @default(now())
}

model ProjectPhase {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("pending")
  order       Int      @default(0)
  projectId   String
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
}

model ProjectMilestone {
  id          String    @id @default(cuid())
  name        String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  projectId   String
  createdAt   DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id])
}

model ImportExportJob {
  id         String   @id @default(cuid())
  type       String
  status     String   @default("pending")
  format     String
  direction  String?
  fileName   String?
  fileUrl    String?
  fileType   String?
  fileSize   Int?
  fileData   String?
  resultData String?
  message    String?
  metadata   String?
  error      String?
  userId     String
  projectId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model ConversionRecord {
  id           String   @id @default(cuid())
  sourceFormat String
  targetFormat String
  sourceData   String
  resultData   String?
  status       String   @default("completed")
  message      String?
  userId       String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model BIMFloorPlan {
  id          String   @id @default(cuid())
  name        String
  description String?
  width       Int      @default(800)
  height      Int      @default(600)
  floorLevel  Int      @default(0)
  scale       Float    @default(1)
  settings    String?
  elementData String   @default("[]")
  userId      String
  projectId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  bimElements BIMElement[]
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("info")
  link      String?
  read      Boolean  @default(false)
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model BIMElement {
  id                  String   @id @default(cuid())
  type                String
  subtype             String?
  name                String?
  x                   Float
  y                   Float
  width               Float?
  height              Float?
  rotation            Float    @default(0)
  properties          String?
  classification      String?
  classificationScore Float?
  layer               String   @default("default")
  color               String?
  floorPlanId         String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  floorPlan BIMFloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
}
